# Anthropic API (required)
ANTHROPIC_API_KEY=sk-ant-...

# Payload CMS (required)
PAYLOAD_CMS_URL=http://localhost:3001
PAYLOAD_API_KEY=your-api-key-here

# SerpAPI for competitor research + GEO/AI-Overview tracking (optional — can use manual URLs)
SERPAPI_API_KEY=your-serpapi-key
# Fallback key: used automatically when the primary is out of monthly searches
SERPAPI_API_KEY_2=your-second-serpapi-key
# Cache TTL (hours) for SerpAPI results — a repeat search within this window reuses
# the cached response instead of spending a credit. Default 144 (6 days). Set 0 to disable.
SERP_CACHE_TTL_HOURS=144

# IndexNow key for instant Bing/Yandex indexing (optional but recommended — free GEO lever).
# The SAME value must be hosted as a text file at https://<host>/<key>.txt on the site root.
INDEXNOW_KEY=your-indexnow-key

# Microsoft Clarity Data Export API token (optional — enables `npm run clarity`).
# Clarity → Settings → Data Export → Generate new API token. Behavior data (rage/dead
# clicks, scroll, engagement) → Claude UX suggestions. Free. Max 10 API calls/day.
CLARITY_API_TOKEN=your-clarity-api-token

# Rate-staleness guard (optional). A `title-meta` recommendation may not promote a price
# into the SERP title/meta if that airport's data/airports/<code>.json is older than this
# many days AND the price isn't already published there. Article prices are only as fresh
# as those files, and nothing in the engine refreshes them — a stale figure buried in the
# body is a nit, but the same figure in a SERP title is the promise that wins the click.
# Quick-answer/FAQ are deliberately NOT gated. Default 150. Set 0 to disable.
PRICE_STALENESS_MAX_DAYS=150

# Unsplash for featured images (optional — can upload manually)
UNSPLASH_ACCESS_KEY=your-unsplash-key

# Backlinks baseline (npm run backlinks)
BING_WEBMASTER_API_KEY=
CLARITY_API_TOKEN=

# Discord webhook for `npm run weekly-report` (optional). Without it the digest is printed only.
DISCORD_WEBHOOK_URL=
