# ===========================================
# Triply Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development  # development | staging | production

# ===========================================
# Supabase
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===========================================
# Reservations Lab
# ===========================================
RESLAB_API_KEY=your_reslab_api_key
RESLAB_API_DOMAIN=triplypro.com
RESLAB_API_URL=https://api.reservationslab.com

# ===========================================
# Stripe
# ===========================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===========================================
# Mapbox
# ===========================================
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token

# ===========================================
# Payload CMS (Blog)
# ===========================================
# PAYLOAD_SECRET is a triply-cms variable (that app's own secret) — this
# (main) app has never had it configured and nothing here reads it; it lives
# in triply-cms/.env.example, not here. See
# src/lib/waitlist/unsubscribe-token.ts for why WAITLIST_SIGNING_SECRET is
# deliberately its own, separate var rather than reusing this one.
# DATABASE_URI uses the same Supabase PostgreSQL connection
# Format: postgres://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URI=postgres://your_supabase_connection_string

# ===========================================
# Sanity CMS (DEPRECATED - using Payload now)
# ===========================================
# NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
# NEXT_PUBLIC_SANITY_DATASET=development
# SANITY_API_TOKEN=your_sanity_api_token

# ===========================================
# Resend (Email)
# ===========================================
RESEND_API_KEY=re_your_resend_api_key

# ===========================================
# Booking waitlist (beyond-the-booking-window signups)
# ===========================================
# Signs the unsubscribe-link token (HMAC of the row id). Its own secret, NOT
# PAYLOAD_SECRET (that's a Payload CMS variable this app has never had) —
# set in all three Vercel envs (Production/Preview/Development). A missing
# value does NOT fail `next build` (see src/lib/waitlist/unsubscribe-token.ts);
# it throws the first time a waitlist route actually signs/verifies a token,
# which surfaces as a 500 + Sentry event on that request. Set it before any
# real waitlist traffic hits an env, not just before merge.
WAITLIST_SIGNING_SECRET=your-waitlist-signing-secret-at-least-32-chars

# ===========================================
# Analytics
# ===========================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================================
# Sentry (Error Tracking)
# ===========================================
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=sntrys_xxx
SENTRY_ORG=triply
SENTRY_PROJECT=triply-web

# ===========================================
# Park Guard (Parking Protection Plan)
# ===========================================
# Server-side only — never NEXT_PUBLIC. Staging uses pgbacklot.com,
# production uses api.parkguardcoveragehub.com.
PARKGUARD_API_KEY=your_parkguard_api_key
PARKGUARD_API_URL=https://api.pgbacklot.com

# Triply service fee = max(TRIPLY_SERVICE_FEE_MIN, TRIPLY_SERVICE_FEE_PERCENT% of parking base).
# Defaults live in src/lib/utils/service-fee.ts (6 / 5.95). Leave these UNSET in Vercel:
# the same function runs in the browser for search/lot estimates, where a server-only
# override is invisible, so setting one here makes the estimate and the charge disagree.
# TRIPLY_SERVICE_FEE_PERCENT=6
# TRIPLY_SERVICE_FEE_MIN=5.95

# ===========================================
# Availability logging (src/lib/availability/log.ts)
# ===========================================
# Kill switch for an incident or a load test. Accepts 1 / true / yes. Setting
# this in the Vercel dashboard does NOT reach already-running deployments —
# flip it, then redeploy. Remember to unset it afterwards: while it is on the
# admin rollup stops gaining new days and only /api/admin/availability's
# `writer` block says why.
# AVAILABILITY_LOG_DISABLED=1
# Rows are tagged with NEXT_PUBLIC_APP_ENV (falling back to Vercel's VERCEL_ENV);
# the rollup only counts env=production.

# Park & Stay (hotel packages via LiteAPI). Master switch + IATA allowlist; empty allowlist = off.
# Rollback = change these AND redeploy. Sandbox key is used whenever STRIPE_SECRET_KEY is a test key.
ENABLE_PARK_STAY=false
PARK_STAY_AIRPORTS=
LITEAPI_SANDBOX_KEY=
LITEAPI_API_KEY=
