n-all duration-300 group opacity-0" style="animation-delay:0ms;animation-fill-mode:forwards"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-x w-7 h-7 text-purple-400 mx-auto mb-3 group-hover:scale-110 transition-transform duration-300" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path><path d="m14 14-4 4"></path><path d="m10 14 4 4"></path></svg><h4 class="text-white font-bold text-sm mb-1">Free Cancellation</h4><p class="text-gray-400 text-xs leading-relaxed">Cancel most bookings for free up to 24 hours before check-in.</p></div><div class="bg-white/10 backdrop-blur-sm border border-white/15 rounded-xl p-5 text-center hover:bg-white/10 transition-all duration-300 group opacity-0" style="animation-delay:0ms;animation-fill-mode:forwards"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-award w-7 h-7 text-brand-orange mx-auto mb-3 group-hover:scale-110 transition-transform duration-300" aria-hidden="true"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"></path><circle cx="12" cy="8" r="6"></circle></svg><h4 class="text-white font-bold text-sm mb-1">Clear Totals</h4><p class="text-gray-400 text-xs leading-relaxed">Taxes and fees are in the price you see; anything paid at the lot is shown before you pay.</p></div><div class="bg-white/10 backdrop-blur-sm border border-white/15 rounded-xl p-5 text-center hover:bg-white/10 transition-all duration-300 group opacity-0" style="animation-delay:0ms;animation-fill-mode:forwards"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check w-7 h-7 text-teal-400 mx-auto mb-3 group-hover:scale-110 transition-transform duration-300" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg><h4 class="text-white font-bold text-sm mb-1">Trusted Lots</h4><p class="text-gray-400 text-xs leading-relaxed">Lots come from established booking partners, and we remove any lot that lets customers down.</p></div><div class="bg-white/10 backdrop-blur-sm border border-white/15 rounded-xl p-5 text-center hover:bg-white/10 transition-all duration-300 group opacity-0" style="animation-delay:0ms;animation-fill-mode:forwards"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-headphones w-7 h-7 text-blue-400 mx-auto mb-3 group-hover:scale-110 transition-transform duration-300" aria-hidden="true"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path></svg><h4 class="text-white font-bold text-sm mb-1">Real Support</h4><p class="text-gray-400 text-xs leading-relaxed">Real humans by email — we reply within 24-48 hours on business days.</p></div></div></div><div class="max-w-4xl mx-auto mb-16"><h3 class="text-2xl md:text-3xl font-bold text-white text-center mb-3">See How Much You Save</h3><p class="text-gray-400 text-center mb-8">Compare on-site airport rates vs. booking with Triply</p><div class="bg-white/10 backdrop-blur-lg border border-white/20 rounded-2xl p-6 md:p-8"><div class="grid md:grid-cols-3 gap-8 mb-8"><div><label class="block text-xs font-bold text-gray-400 uppercase mb-2">Airport</label><div class="relative"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plane absolute left-3 top-1/2 -translate-y-1/2 text-brand-orange w-5 h-5" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"></path></svg><select class="w-full pl-10 pr-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white focus:ring-2 focus:ring-brand-orange focus:border-transparent outline-none cursor-pointer"><option value="JFK" class="text-gray-900" selected="">JFK - JFK International</option><option value="LGA" class="text-gray-900">LGA - LaGuardia</option></select></div></div><div class="md:col-span-2"><label class="block text-xs font-bold text-gray-400 uppercase mb-2">Trip Length</label><div class="flex flex-wrap gap-2"><button class="px-4 py-2.5 rounded-lg text-sm font-medium transition-all cursor-pointer bg-white/10 text-gray-300 hover:bg-white/20">3 days</button><button class="px-4 py-2.5 rounded-lg text-sm font-medium transition-all cursor-pointer bg-white/10 text-gray-300 hover:bg-white/20">5 days</button><button class="px-4 py-2.5 rounded-lg text-sm font-medium transition-all cursor-pointer bg-brand-orange text-white shadow-lg shadow-brand-orange/30">7 days</button><button class="px-4 py-2.5 rounded-lg text-sm font-medium transition-all cursor-pointer bg-white/10 text-gray-300 hover:bg-white/20">10 days</button><button class="px-4 py-2.5 rounded-lg text-sm font-medium transition-all cursor-pointer bg-white/10 text-gray-300 hover:bg-white/20">14 days</button><button class="px-4 py-2.5 rounded-lg text-sm font-medium transition-all cursor-pointer bg-white/10 text-gray-300 hover:bg-white/20">21 days</button></div></div></div><div class="grid md:grid-cols-3 gap-6 transition-all duration-500 scale-100 opacity-100"><div class="bg-red-500/15 border border-red-500/25 rounded-xl p-5 text-center"><p class="text-red-400 text-xs font-bold uppercase mb-1">On-Site Airport</p><p class="text-3xl font-bold text-red-400 line-through decoration-2">$245</p><p class="text-gray-500 text-sm mt-1">$35/day</p></div><div class="bg-green-500/15 border border-green-500/25 rounded-xl p-5 text-center"><p class="text-green-400 text-xs font-bold uppercase mb-1">With Triply</p><p class="text-3xl font-bold text-green-400">$98</p><p class="text-gray-500 text-sm mt-1">$14/day</p></div><div class="bg-brand-orange/25 border border-brand-orange/40 rounded-xl p-5 text-center relative overflow-hidden"><div class="absolute -top-2 -right-2 bg-brand-orange text-white text-xs font-bold px-2 py-1 rounded-bl-lg">60% OFF</div><p class="text-brand-orange text-xs font-bold uppercase mb-1">You Save</p><p class="text-3xl font-bold text-brand-orange flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-down w-6 h-6 mr-1" aria-hidden="true"><path d="M16 17h6v-6"></path><path d="m22 17-8.5-8.5-5 5L2 7"></path></svg>$147</p><p class="text-gray-400 text-sm mt-1">on your 7-day trip</p></div></div></div><p class="text-center text-gray-500 text-sm mt-4">* Rates shown are averages. Actual prices may vary based on dates and availability.</p></div><div class="text-center"><a href="/search" class="inline-flex items-center gap-3 bg-brand-orange text-white font-bold px-10 py-5 rounded-full hover:bg-white hover:text-brand-dark transition-all duration-300 shadow-2xl shadow-brand-orange/40 hover:shadow-xl hover:scale-105 text-lg cursor-pointer">Start Saving Now<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><p class="text-gray-400 text-sm mt-4">No signup required · Clear totals · Free to use</p></div></div></section><section class="py-20 lg:py-24 bg-brand-gray"><div class="max-w-3xl mx-auto px-4 sm:px-6"><div class="text-center mb-12"><h2 class="text-3xl font-bold text-gray-900">Frequently Asked Questions</h2></div><div class="space-y-4"><div class="bg-white rounded-xl overflow-hidden transition-all duration-300 border border-brand-orange shadow-md"><button class="w-full flex justify-between items-center p-6 text-left focus:outline-none"><span class="font-bold text-lg text-brand-orange">How does Triply save me money?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-up text-brand-orange flex-shrink-0" aria-hidden="true"><path d="m18 15-6-6-6 6"></path></svg></button><div class="px-6 transition-all duration-300 ease-in-out overflow-hidden max-h-[40rem] pb-6 opacity-100"><p class="text-gray-600 leading-relaxed">Triply aggregates real-time pricing from parking facilities near major airports, so you compare every available lot in one place instead of hunting for them one by one. Off-airport lots often cost 40-60% less than parking at the airport itself.</p></div></div><div class="bg-white rounded-xl overflow-hidden transition-all duration-300 border border-gray-200"><button class="w-full flex justify-between items-center p-6 text-left focus:outline-none"><span class="font-bold text-lg text-gray-900">What airports do you serve?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-gray-400 flex-shrink-0" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div class="px-6 transition-all duration-300 ease-in-out overflow-hidden max-h-0 opacity-0"><p class="text-gray-600 leading-relaxed">Triply covers 85+ airports across the United States and Canada — JFK, LaGuardia, Newark, Boston, Los Angeles and many more. Search your airport to see the lots available for your dates; a few airports have no online availability yet.</p></div></div><div class="bg-white rounded-xl overflow-hidden transition-all duration-300 border border-gray-200"><button class="w-full flex justify-between items-center p-6 text-left focus:outline-none"><span class="font-bold text-lg text-gray-900">Is cancellation really free?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-gray-400 flex-shrink-0" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div class="px-6 transition-all duration-300 ease-in-out overflow-hidden max-h-0 opacity-0"><p class="text-gray-600 leading-relaxed">Yes, on the vast majority of bookings. Cancel up to 24 hours before check-in from the account the booking is linked to and you get back everything you paid online — if you booked as a guest, sign in with the same email first. If you added Park Guard protection, its small non-refundable portion stays. Within 24 hours of check-in, email support@triplypro.com.</p></div></div><div class="bg-white rounded-xl overflow-hidden transition-all duration-300 border border-gray-200"><button class="w-full flex justify-between items-center p-6 text-left focus:outline-none"><span class="font-bold text-lg text-gray-900">How do I get to the parking lot?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-gray-400 flex-shrink-0" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div class="px-6 transition-all duration-300 ease-in-out overflow-hidden max-h-0 opacity-0"><p class="text-gray-600 leading-relaxed">Each parking lot provides detailed directions in your booking confirmation. Most lots offer free shuttle service to and from the airport terminal. Shuttle frequency and hours vary by lot - check the lot details before booking to find the best option for your flight time.</p></div></div><div class="bg-white rounded-xl overflow-hidden transition-all duration-300 border border-gray-200"><button class="w-full flex justify-between items-center p-6 text-left focus:outline-none"><span class="font-bold text-lg text-gray-900">Is my car safe?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-gray-400 flex-shrink-0" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div class="px-6 transition-all duration-300 ease-in-out overflow-hidden max-h-0 opacity-0"><p class="text-gray-600 leading-relaxed">Our lots come from established booking partners, and we remove any lot that lets customers down. Many lots have 24/7 security, surveillance cameras, fenced perimeters, and well-lit areas — check the security amenities listed on each lot&#x27;s detail page before you book.</p></div></div><div class="bg-white rounded-xl overflow-hidden transition-all duration-300 border border-gray-200"><button class="w-full flex justify-between items-center p-6 text-left focus:outline-none"><span class="font-bold text-lg text-gray-900">How do I modify my booking?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-gray-400 flex-shrink-0" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div class="px-6 transition-all duration-300 ease-in-out overflow-hidden max-h-0 opacity-0"><p class="text-gray-600 leading-relaxed">There&#x27;s no edit option yet. More than 24 hours before check-in, cancel the booking from My Reservations for free and book again with the new details. Otherwise email support@triplypro.com — we reply within 24-48 hours on business days.</p></div></div><div class="bg-white rounded-xl overflow-hidden transition-all duration-300 border border-gray-200"><button class="w-full flex justify-between items-center p-6 text-left focus:outline-none"><span class="font-bold text-lg text-gray-900">How far in advance should I book?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-gray-400 flex-shrink-0" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div class="px-6 transition-all duration-300 ease-in-out overflow-hidden max-h-0 opacity-0"><p class="text-gray-600 leading-relaxed">We recommend booking at least a few days in advance, especially during peak travel seasons and holidays. However, we often have same-day availability depending on the lot.</p></div></div><div class="bg-white rounded-xl overflow-hidden transition-all duration-300 border border-gray-200"><button class="w-full flex justify-between items-center p-6 text-left focus:outline-none"><span class="font-bold text-lg text-gray-900">What if my flight is delayed?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-gray-400 flex-shrink-0" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div class="px-6 transition-all duration-300 ease-in-out overflow-hidden max-h-0 opacity-0"><p class="text-gray-600 leading-relaxed">Your spot is reserved for your whole booking period, and most lots are used to delayed flights. Some charge on site for staying past your booked time (see the lot&#x27;s details), so if you&#x27;ll be back late, contact the lot using the number on your confirmation.</p></div></div></div></div></section><section class="bg-gray-50 py-16"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="text-center mb-10"><h2 class="text-2xl md:text-3xl font-bold text-gray-900">Browse Airport Parking</h2><p class="text-gray-500 mt-2">Compare parking at 85+ airports across the US and Canada</p></div><div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3"><a href="/new-york-jfk/airport-parking" class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 bg-white hover:border-brand-orange/30 hover:shadow-sm transition-all group"><div class="w-8 h-8 rounded-full bg-gray-100 group-hover:bg-brand-orange/10 flex items-center justify-center shrink-0 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plane w-4 h-4 text-gray-400 group-hover:text-brand-orange transition-colors" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"></path></svg></div><div class="min-w-0"><span class="text-sm font-medium text-gray-900 block truncate">New York (JFK)</span><span class="text-xs text-gray-400 block truncate">NY</span></div></a><a href="/los-angeles-lax/airport-parking" class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 bg-white hover:border-brand-orange/3