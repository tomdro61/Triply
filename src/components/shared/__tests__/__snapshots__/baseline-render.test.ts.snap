ray-200 bg-white hover:border-brand-orange/30 hover:shadow-sm transition-all group"><div class="w-8 h-8 rounded-full bg-gray-100 group-hover:bg-brand-orange/10 flex items-center justify-center shrink-0 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plane w-4 h-4 text-gray-400 group-hover:text-brand-orange transition-colors" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"></path></svg></div><div class="min-w-0"><span class="text-sm font-medium text-gray-900 block truncate">Atlanta (ATL)</span><span class="text-xs text-gray-400 block truncate">GA</span></div></a><a href="/miami-mia/airport-parking" class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 bg-white hover:border-brand-orange/30 hover:shadow-sm transition-all group"><div class="w-8 h-8 rounded-full bg-gray-100 group-hover:bg-brand-orange/10 flex items-center justify-center shrink-0 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plane w-4 h-4 text-gray-400 group-hover:text-brand-orange transition-colors" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"></path></svg></div><div class="min-w-0"><span class="text-sm font-medium text-gray-900 block truncate">Miami (MIA)</span><span class="text-xs text-gray-400 block truncate">FL</span></div></a><a href="/san-francisco-sfo/airport-parking" class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 bg-white hover:border-brand-orange/30 hover:shadow-sm transition-all group"><div class="w-8 h-8 rounded-full bg-gray-100 group-hover:bg-brand-orange/10 flex items-center justify-center shrink-0 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plane w-4 h-4 text-gray-400 group-hover:text-brand-orange transition-colors" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"></path></svg></div><div class="min-w-0"><span class="text-sm font-medium text-gray-900 block truncate">San Francisco (SFO)</span><span class="text-xs text-gray-400 block truncate">CA</span></div></a><a href="/dallas-dfw/airport-parking" class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 bg-white hover:border-brand-orange/30 hover:shadow-sm transition-all group"><div class="w-8 h-8 rounded-full bg-gray-100 group-hover:bg-brand-orange/10 flex items-center justify-center shrink-0 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plane w-4 h-4 text-gray-400 group-hover:text-brand-orange transition-colors" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"></path></svg></div><div class="min-w-0"><span class="text-sm font-medium text-gray-900 block truncate">Dallas (DFW)</span><span class="text-xs text-gray-400 block truncate">TX</span></div></a><a href="/denv